[package]
name = "cszip"
version = "0.1.0"
edition = "2021"
authors = ["Tu Nombre <tu.email@example.com>"]
description = "High-performance lossless file compression tool with custom format"
license = "MIT"
repository = "https://github.com/user/CsZip"
documentation = "https://docs.rs/CsZip"
keywords = ["compression", "zstd", "lz77", "streaming", "lossless"]
categories = ["compression", "command-line-utilities"]
readme = "README.md"

[lib]
name = "cszip"
path = "src/lib.rs"

[[bin]]
name = "cszip"
path = "src/main.rs"
required-features = []

[dependencies]
# CLI y argumentos
clap = { version = "4.4", features = ["derive"] }

# Manejo de errores
thiserror = "1.0"

# Serialización (opcional, para futuro)
serde = { version = "1.0", features = ["derive"], optional = true }

# Paralelización (opcional, para futuro)
rayon = { version = "1.7", optional = true }

# Progress bar (opcional)
indicatif = { version = "0.17", optional = true }

[dev-dependencies]
# Benchmarking
criterion = "0.5"

# Testing
proptest = "1.3"
quickcheck = "1.0"
quickcheck_macros = "1.0"

# Fixtures y utilidades
tempfile = "3.8"
rand = "0.8"

# Profiling (opcional)
pprof = { version = "0.13", features = ["flamegraph"] }

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
strip = true
panic = "abort"

[profile.bench]
inherits = "release"

[profile.dev]
opt-level = 1

# Benchmarks
[[bench]]
name = "compress_throughput"
harness = false

[[bench]]
name = "decompress_throughput"
harness = false

[[bench]]
name = "compression_ratio"
harness = false

# Ejemplos
[[example]]
name = "basic_compress"
path = "examples/basic_compress.rs"

[[example]]
name = "basic_decompress"
path = "examples/basic_decompress.rs"

[[example]]
name = "streaming"
path = "examples/streaming.rs"

[[example]]
name = "library_api"
path = "examples/library_api.rs"

# Características opcionales
[features]
default = []
serde = ["dep:serde"]
parallel = ["dep:rayon"]
progress = ["dep:indicatif"]
all = ["serde", "parallel", "progress"]

# Metadata para documentación
[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

# Metadata para benchmarks
[package.metadata.criterion.profile.bench]
target-dir = "target/criterion"
